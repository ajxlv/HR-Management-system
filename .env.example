# ---- Server ----
PORT=3000
DATA_DIR=./data
# Long random string. Sessions stop working after restart if left empty.
SESSION_SECRET=
# Who can sign in: one PIN per vendor (4 to 8 digits, every vendor a different PIN). The PIN is how the app knows who signed in,
# and the vendor's name is written in the Cleaner column of the sheet. Separate the vendors with a semicolon.
#   VENDORS=Sandeep=4821;Uttam mama=7733;Akshay=9054
VENDORS=
# Only used when VENDORS is empty (one shared PIN). Leave both empty ONLY for local testing (no login).
CLEANER_NAME=Cleaner
CLEANER_PIN=

# ---- Photos: local (demo) or onedrive ----
STORAGE=local
# Name of the folder in OneDrive that holds one folder per client
ROOT_FOLDER=Clients
# Microsoft 365 app registration (client credentials). See README.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Either the drive id, or the user (e.g. hr@wrs.com) whose OneDrive holds the folders
MS_DRIVE_ID=
MS_USER=

# ---- Status sheet: google (HR's view), excel (demo file) or csv ----
SHEET=google
# The long id in the sheet's address: docs.google.com/spreadsheets/d/<THIS PART>/edit
SHEET_ID=1DeUwU_Cc61iGfl8zran6VfLayzDIp_qnrGVF2czk0eA
# Path to the JSON key you downloaded from Google Cloud (never commit it). Windows example: C:\keys\wrs-hr-key.json
GOOGLE_KEY_FILE=
# Alternative to the key file (leave both empty if you use GOOGLE_KEY_FILE):
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Public link to the WRS logo for the banner (see README, "Logo in the sheet"). Empty = the text "WRS Energy".
LOGO_URL=
# If Google is unreachable, waiting rows are retried this often (milliseconds)
SHEET_RETRY_MS=60000

# ---- Rules ----
# 1 = today and yesterday
MAX_DAYS_BACK=1
PHOTO_MAX_AGE_SEC=180
GPS_MAX_DISTANCE_M=300

# ---- Optional ----
# Save photos straight into a folder on this PC, e.g. the OneDrive sync folder (STORAGE=local).
# Then no Microsoft app registration is needed.  Example: C:\Users\HR\OneDrive - WRS
LOCAL_ROOT=
# Lets HR download the Excel file at /report.xlsx?key=THIS_VALUE  (leave empty to switch off)
REPORT_KEY=
