PORT=3000
# Where photos go: local (folder ./storage, for testing) or onedrive
STORAGE=local
# Where the status table goes: local (CSV files in ./storage/sheets) or google
SHEET=local
# Photos further than this from the client's saved location are flagged
MAX_DISTANCE_M=300
# How many days back a cleaner may pick
MAX_BACK_DAYS=7

# --- OneDrive. Folder that holds one sub-folder per client
ONEDRIVE_ROOT=Clients
# Option A: Microsoft 365 / OneDrive for Business (app registration, admin consent, Files.ReadWrite.All)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DRIVE_ID=
# Option B: personal OneDrive (delegated sign-in once, see README). Leave MS_TENANT_ID empty and set:
MS_REFRESH_TOKEN=

# --- Google Sheet (service account; share the sheet with its email as Editor)
GOOGLE_SHEET_ID=
GOOGLE_SA_EMAIL=
# Private key with \n for line breaks
GOOGLE_SA_KEY=
