# ---- Server ----
PORT=3000
DATA_DIR=./data
# Long random string. Sessions stop working after restart if left empty.
SESSION_SECRET=
# The one cleaner. Leave PIN empty ONLY for local testing (no login).
CLEANER_NAME=Cleaner
CLEANER_PIN=

# ---- Photos: local (demo) or onedrive ----
STORAGE=local
# Name of the folder in OneDrive that holds one folder per client
ROOT_FOLDER=Clients
# Microsoft 365 app registration (client credentials). See README.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Either the drive id, or the user (e.g. hr@wrs.com) whose OneDrive holds the folders
MS_DRIVE_ID=
MS_USER=

# ---- Status sheet: csv (demo) or google ----
SHEET=csv
SHEET_ID=1DeUwU_Cc61iGfl8zran6VfLayzDIp_qnrGVF2czk0eA
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---- Rules ----
MAX_DAYS_BACK=7
PHOTO_MAX_AGE_SEC=180
GPS_MAX_DISTANCE_M=300
